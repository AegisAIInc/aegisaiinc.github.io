{
  "name": "aegisai-marketing",
  "version": "1.0.0",
  "description": "AegisAI - Shield Against Rogue AI | Marketing Website",
  "scripts": {
    "build": "npm run css:build && eleventy",
    "dev": "eleventy --serve",
    "start": "npm run css:build && eleventy --serve",
    "css:build": "tailwindcss -i ./src/css/input.css -o ./src/css/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/css/input.css -o ./src/css/styles.css --watch"
  },
  "keywords": ["eleventy", "11ty", "aegisai", "marketing"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@11ty/eleventy": "^3.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14"
  }
}
