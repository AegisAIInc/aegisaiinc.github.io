<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="{% if meta_description %}{{ meta_description }}{% else %}AegisAI: Shield Against Rogue AI. Self-evolving defensive software that detects and counters self-replicating AI agents in real-time.{% endif %}">
  <meta name="keywords" content="AegisAI, rogue AI, AI security, AI defense, cybersecurity, AI threat detection">
  <meta property="og:title" content="{% if title %}{{ title }} | AegisAI{% else %}AegisAI: Shield Against Rogue AI{% endif %}">
  <meta property="og:description" content="{% if meta_description %}{{ meta_description }}{% else %}Self-evolving guardian against rogue AI threats.{% endif %}">
  <meta property="og:type" content="website">
  <title>{% if title %}{{ title }} | AegisAI{% else %}AegisAI: Shield Against Rogue AI{% endif %}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
</head>
<body class="bg-dark-900 text-gray-100 font-sans antialiased min-h-screen flex flex-col">
  {% include 'header' %}
  <main class="flex-1">
    {{ content }}
  </main>
  {% include 'footer' %}
</body>
</html>
