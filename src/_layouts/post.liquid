---
layout: base
---

<section class="py-16 lg:py-24">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <article class="max-w-none [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-white [&_h2]:mt-8 [&_h2]:mb-4 [&_p]:text-gray-400 [&_p]:mb-4 [&_ul]:text-gray-400 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6">
      <time class="text-aegis-400 font-mono text-sm">{{ date | date: "%B %d, %Y" }}</time>
      <h1 class="text-4xl font-bold text-white mt-2 mb-6">{{ title }}</h1>

      {{ content }}

      <div class="mt-12 pt-8 border-t border-dark-600">
        <p class="text-gray-400 mb-4">Ready to protect your systems from rogue AI?</p>
        <a href="/pricing/" class="inline-flex items-center justify-center px-6 py-3 bg-gradient-to-r from-aegis-500 to-aegis-600 text-white font-semibold rounded-lg hover:from-aegis-600 hover:to-aegis-700 transition-all">
          Try AegisAI Free
        </a>
      </div>

      <a href="/blog/" class="inline-flex items-center gap-2 mt-8 text-aegis-400 hover:text-aegis-300 transition-colors">
        ← Back to Blog
      </a>
    </article>
  </div>
</section>
