<script>
(function(){var h=document.documentElement;function toggle(){var isDark=h.classList.contains('dark');h.classList.toggle('dark',!isDark);h.classList.toggle('light',isDark);localStorage.setItem('aegis-theme',isDark?'light':'dark');}['theme-toggle','theme-toggle-desktop','theme-toggle-mobile'].forEach(function(id){var b=document.getElementById(id);if(b)b.addEventListener('click',toggle);});})();
</script>
