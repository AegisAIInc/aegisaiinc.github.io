---
layout: base
title: Blog
meta_description: "AegisAI blog - insights on AI security, rogue AI threats, and defensive strategies. Stay updated on the latest in AI-powered cybersecurity."
permalink: /blog/
---

<section class="py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-5xl font-bold text-white mb-4">AegisAI Blog</h1>
      <p class="text-xl text-gray-400 max-w-2xl mx-auto">Insights on AI security, rogue AI threats, and defensive strategies</p>
    </div>

    <div class="grid lg:grid-cols-3 gap-8 lg:gap-12">
      {% comment %} Main content - post listing with reversed collection {% endcomment %}
      <div class="lg:col-span-2">
        <div class="space-y-8">
          {% for post in collections.blog reversed %}
          <article class="group bg-dark-800/50 rounded-xl border border-dark-600 overflow-hidden hover:border-aegis-500/30 transition-colors">
            <a href="{{ post.url }}" class="block">
              <div class="h-40 bg-dark-700 flex items-center justify-center border-b border-dark-600">
                <div class="w-16 h-16 rounded-lg bg-aegis-500/20 flex items-center justify-center group-hover:bg-aegis-500/30 transition-colors">
                  <svg class="w-8 h-8 text-aegis-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                </div>
              </div>
              <div class="p-6">
                <time class="text-sm text-aegis-400 font-mono">{{ post.data.date | date: "%B %d, %Y" }}</time>
                <h2 class="text-xl font-semibold text-white mt-2 mb-2 group-hover:text-aegis-400 transition-colors">{{ post.data.title }}</h2>
                <p class="text-gray-400 text-sm line-clamp-2">{{ post.data.description }}</p>
              </div>
            </a>
          </article>
          {% endfor %}
        </div>
      </div>

      {% comment %} Sidebar: recent posts + newsletter {% endcomment %}
      <aside class="lg:col-span-1">
        <div class="sticky top-24 space-y-8">
          <div class="p-6 rounded-xl bg-dark-700/50 border border-dark-600">
            <h3 class="text-lg font-semibold text-white mb-4">Recent Posts</h3>
            <ul class="space-y-3">
              {% for post in collections.blog limit: 5 %}
              <li>
                <a href="{{ post.url }}" class="text-gray-400 hover:text-aegis-400 transition-colors text-sm flex flex-col">
                  <span class="font-medium text-white">{{ post.data.title }}</span>
                  <time class="text-xs text-gray-500 mt-0.5">{{ post.data.date | date: "%b %d, %Y" }}</time>
                </a>
              </li>
              {% endfor %}
            </ul>
          </div>

          <div class="p-6 rounded-xl bg-dark-700/50 border border-dark-600">
            <h3 class="text-lg font-semibold text-white mb-2">Stay Updated</h3>
            <p class="text-gray-400 text-sm mb-4">Get AegisAI security insights and product updates in your inbox.</p>
            <form action="/contact/" method="get" class="space-y-2">
              <input type="hidden" name="interest" value="newsletter">
              <input type="email" name="email" placeholder="you@example.com" required class="w-full px-4 py-2.5 bg-dark-600 border border-dark-500 rounded-lg text-white placeholder-gray-500 text-sm focus:ring-2 focus:ring-aegis-500 focus:border-transparent">
              <button type="submit" class="w-full py-2.5 bg-aegis-600 text-white font-medium rounded-lg hover:bg-aegis-500 transition-colors text-sm">
                Subscribe
              </button>
            </form>
          </div>
        </div>
      </aside>
    </div>
  </div>
</section>
