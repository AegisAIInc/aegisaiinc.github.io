<script>
(function() {
  const toggles = document.querySelectorAll('.pricing-toggle');
  const priceEls = document.querySelectorAll('[data-price-monthly]');
  const periodLabels = document.querySelectorAll('.pricing-period-label');

  function setBilling(period) {
    toggles.forEach(t => {
      const isActive = t.dataset.period === period;
      t.classList.toggle('bg-aegis-600', isActive);
      t.classList.toggle('text-white', isActive);
      t.classList.toggle('text-gray-400', !isActive);
    });
    priceEls.forEach(el => {
      const monthly = el.dataset.priceMonthly;
      const yearly = el.dataset.priceYearly;
      el.textContent = period === 'monthly' ? monthly : yearly;
    });
    periodLabels.forEach(l => l.textContent = period === 'monthly' ? 'mo' : 'yr');
  }

  toggles.forEach(btn => {
    btn.addEventListener('click', () => setBilling(btn.dataset.period));
  });

  setBilling('monthly');
})();
</script>
